use Test;

use Dawa;

plan 4;

my %y = ( x => 2 );

is %y<x>, 2, 'statement worked';

my $x = 1;

my $promise = start {
  sleep 1;
  loop { $x += 5; last; }
}

await $promise;

is $x, 6, "promise worked";

my %z := { a => 1 }

is %z<a>, 1, 'hash constructor';

my @a = (1..3).grep: * > 2;
ok @a.elems == 1, 'grepped';

